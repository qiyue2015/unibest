# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

VITE_WX_APPID = 'wx0584b3f500123911'
VITE_WX_UNIACID = 94

VITE_SERVER_BASEURL = 'https://wx.wifixc.com'
VITE_UPLOAD_BASEURL = 'https://wx.wifixc.com/app/index.php?c=utility&a=file&do=upload'

# 有些同学可能需要在微信小程序里面根据 develop、trial、release 分别设置上传地址，参考代码如下。
# 下面的变量如果没有设置，会默认使用 VITE_SERVER_BASEURL or VITE_UPLOAD_BASEURL
VITE_SERVER_BASEURL__WEIXIN_DEVELOP = 'https://wx.wifixc.com'
VITE_SERVER_BASEURL__WEIXIN_TRIAL = 'https://wx.wifixc.com'
VITE_SERVER_BASEURL__WEIXIN_RELEASE = 'https://wx.wifixc.com'

VITE_UPLOAD_BASEURL__WEIXIN_DEVELOP = 'https://wx.wifixc.com/app/index.php?c=utility&a=file&do=upload'
VITE_UPLOAD_BASEURL__WEIXIN_TRIAL = 'https://wx.wifixc.com/app/index.php?c=utility&a=file&do=upload'
VITE_UPLOAD_BASEURL__WEIXIN_RELEASE = 'https://wx.wifixc.com/app/index.php?c=utility&a=file&do=upload'
